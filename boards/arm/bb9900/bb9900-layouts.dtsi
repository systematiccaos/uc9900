#include <physical_layouts.dtsi>

/ {
    // Physical layout for the uConsole keyboard with the BB9900 trackpad.
    // Coordinates are in 1/100 of a key unit, generated from config/info.json.
    bb9900_layout: bb9900_layout {
        compatible = "zmk,physical-layout";
        display-name = "uConsole 9900";
        transform = <&default_transform>;

        keys  //                     w   h    x    y   rot    rx    ry
            = <&key_physical_attrs 100 100  300    0   0    0     0>
            , <&key_physical_attrs 100 100  600    0   0    0     0>
            , <&key_physical_attrs 100 100  800    0   0    0     0>
            , <&key_physical_attrs 100 100 1050    0   0    0     0>
            , <&key_physical_attrs 100 100 1200    0   0    0     0>
            , <&key_physical_attrs 100 100  200  100   0    0     0>
            , <&key_physical_attrs 100 100  400  100   0    0     0>
            , <&key_physical_attrs 100 100  300  100   0    0     0>
            , <&key_physical_attrs 100 100  650  100   0    0     0>
            , <&key_physical_attrs 100 100 1100  100   0    0     0>
            , <&key_physical_attrs 100 100 1250  100   0    0     0>
            , <&key_physical_attrs 200 100    0  200   0    0     0>
            , <&key_physical_attrs 200 100  210  200   0    0     0>
            , <&key_physical_attrs 200 100  420  200   0    0     0>
            , <&key_physical_attrs 100 100  650  200   0    0     0>
            , <&key_physical_attrs 100 100  780  200   0    0     0>
            , <&key_physical_attrs 100 100  880  200   0    0     0>
            , <&key_physical_attrs 100 100  980  200   0    0     0>
            , <&key_physical_attrs 100 100 1080  200   0    0     0>
            , <&key_physical_attrs 100 100 1180  200   0    0     0>
            , <&key_physical_attrs 100 100 1280  200   0    0     0>
            , <&key_physical_attrs 100 100   50  300   0    0     0>
            , <&key_physical_attrs 100 100  150  300   0    0     0>
            , <&key_physical_attrs 100 100  250  300   0    0     0>
            , <&key_physical_attrs 100 100  350  300   0    0     0>
            , <&key_physical_attrs 100 100  450  300   0    0     0>
            , <&key_physical_attrs 100 100  550  300   0    0     0>
            , <&key_physical_attrs 100 100  650  300   0    0     0>
            , <&key_physical_attrs 100 100  750  300   0    0     0>
            , <&key_physical_attrs 100 100  850  300   0    0     0>
            , <&key_physical_attrs 100 100  950  300   0    0     0>
            , <&key_physical_attrs 100 100 1050  300   0    0     0>
            , <&key_physical_attrs 200 100 1150  300   0    0     0>
            , <&key_physical_attrs 200 100    0  400   0    0     0>
            , <&key_physical_attrs 100 100  200  400   0    0     0>
            , <&key_physical_attrs 100 100  300  400   0    0     0>
            , <&key_physical_attrs 100 100  400  400   0    0     0>
            , <&key_physical_attrs 100 100  500  400   0    0     0>
            , <&key_physical_attrs 100 100  600  400   0    0     0>
            , <&key_physical_attrs 100 100  700  400   0    0     0>
            , <&key_physical_attrs 100 100  800  400   0    0     0>
            , <&key_physical_attrs 100 100  900  400   0    0     0>
            , <&key_physical_attrs 100 100 1000  400   0    0     0>
            , <&key_physical_attrs 100 100 1100  400   0    0     0>
            , <&key_physical_attrs 100 100   50  500   0    0     0>
            , <&key_physical_attrs 100 100  150  500   0    0     0>
            , <&key_physical_attrs 100 100  250  500   0    0     0>
            , <&key_physical_attrs 100 100  350  500   0    0     0>
            , <&key_physical_attrs 100 100  450  500   0    0     0>
            , <&key_physical_attrs 100 100  550  500   0    0     0>
            , <&key_physical_attrs 100 100  650  500   0    0     0>
            , <&key_physical_attrs 100 100  750  500   0    0     0>
            , <&key_physical_attrs 100 100  850  500   0    0     0>
            , <&key_physical_attrs 100 100  950  500   0    0     0>
            , <&key_physical_attrs 100 100 1050  500   0    0     0>
            , <&key_physical_attrs 200 100 1150  500   0    0     0>
            , <&key_physical_attrs 200 100    0  600   0    0     0>
            , <&key_physical_attrs 100 100  200  600   0    0     0>
            , <&key_physical_attrs 100 100  300  600   0    0     0>
            , <&key_physical_attrs 100 100  400  600   0    0     0>
            , <&key_physical_attrs 100 100  500  600   0    0     0>
            , <&key_physical_attrs 100 100  600  600   0    0     0>
            , <&key_physical_attrs 100 100  700  600   0    0     0>
            , <&key_physical_attrs 100 100  800  600   0    0     0>
            , <&key_physical_attrs 100 100  900  600   0    0     0>
            , <&key_physical_attrs 100 100 1000  600   0    0     0>
            , <&key_physical_attrs 200 100 1100  600   0    0     0>
            , <&key_physical_attrs 150 100  100  700   0    0     0>
            , <&key_physical_attrs 150 100  250  700   0    0     0>
            , <&key_physical_attrs 150 100  400  700   0    0     0>
            , <&key_physical_attrs 350 100  550  700   0    0     0>
            , <&key_physical_attrs 150 100  900  700   0    0     0>
            , <&key_physical_attrs 150 100 1050  700   0    0     0>
            , <&key_physical_attrs 150 100 1200  700   0    0     0>
            ;
    };
};
